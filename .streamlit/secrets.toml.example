# Streamlit Cloud / 로컬 secrets 템플릿
# 실키가 들어간 secrets.toml 은 .gitignore 로 제외됩니다.
# Streamlit Cloud: App settings > Secrets 에 아래 내용을 그대로 붙여넣기.

# ─── Anthropic Vision (식단 분석) ───
ANTHROPIC_API_KEY = "sk-ant-여기에_본인_키"

# ─── Google Sheets 영구 저장 ───
# 시트 ID: https://docs.google.com/spreadsheets/d/【여기】/edit 의 가운데 부분
spreadsheet_id = "여기에_시트_ID"

# 서비스 계정 JSON 키 — Google Cloud Console에서 다운로드한 JSON 파일의 값을 그대로 옮겨 적기
# (private_key 의 줄바꿈은 \n 그대로 유지)
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-bot@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
